# backend/.env — copy to backend/.env and fill in. NEVER commit the real .env.

# ── Mistral Generative AI (server-side only — never expose to the frontend) ──
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional overrides
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=30

# ── General ──────────────────────────────────────────────────────────────────
# Frontend origin used for CORS when calling the API directly (without the
# Vite dev proxy).
# FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://house-price-prediction-system-woad.vercel.app
ALLOWED_ORIGINS=https://house-price-prediction-system-woad.vercel.app
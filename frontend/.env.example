# Base URL of the FastAPI backend.
#
# Leave EMPTY to use the Vite dev-server proxy (recommended for local
# development — requests go to the same origin, e.g. /api/predict, and Vite
# forwards them to the backend below).
#
# Set it explicitly when the backend runs elsewhere, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=https://housepredict-ai-backend.onrender.com

# Target used by the Vite dev proxy for /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
